# 复制为 .env 后填写实际值
# 命令（PowerShell）：Copy-Item .env.example .env

# ===== Django =====
# 生成方式：python -c "import secrets;print(secrets.token_urlsafe(50))"
DJANGO_SECRET_KEY=
DJANGO_DEBUG=True
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1

# ===== MySQL 8.0 =====
DB_NAME=hrms
DB_USER=root
DB_PASSWORD=
DB_HOST=127.0.0.1
DB_PORT=3306

# ===== AI 应答机器人 =====
# rules = 纯离线规则模式（默认）；cloud = 走 DeepSeek API，失败自动回落规则模式
AI_PROVIDER=rules
DEEPSEEK_API_KEY=
DEEPSEEK_MODEL=deepseek-chat
AI_REQUEST_TIMEOUT=8

# ===== 超级管理员（首次初始化用）=====
SUPERUSER_USERNAME=admin
SUPERUSER_PASSWORD=
SUPERUSER_REAL_NAME=系统管理员
SUPERUSER_EMPLOYEE_NO=ADMIN001
SUPERUSER_ID_CARD=110101199001011234
SUPERUSER_GENDER=M
